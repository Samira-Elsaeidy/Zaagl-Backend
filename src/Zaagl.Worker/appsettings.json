{
  // ARC-012 / BE-013 worker. Same sections as the API where shared (ConnectionStrings, Storage).
  "ConnectionStrings": {
    "Postgres": "Host=localhost;Port=5433;Database=zaagl;Username=zaagl;Password=zaagl_dev",
    // Optional: a separate login/pool for jobs; falls back to Postgres. Pool capped at Jobs:MaxPoolSize.
    "Jobs": ""
  },
  // Must be the same directory (same filesystem) the API uses (see the API's appsettings.json).
  "Storage": {
    "Root": "",
    "InternalPathPrefix": "/_protected/"
  },
  "Jobs": {
    "MaxPoolSize": 10,
    // Runner for files.tasks: claim BatchSize per poll, MaxConcurrency at once, lease LeaseSeconds (extended every
    // lease/3), done rows kept DoneRetentionDays, ShutdownGraceSeconds for running tasks on SIGTERM.
    "Files": {
      "BatchSize": 10,
      "MaxConcurrency": 4,
      "PollIntervalMs": 2000,
      "LeaseSeconds": 300,
      "DoneRetentionDays": 7,
      "ShutdownGraceSeconds": 55
    }
  },
  "Worker": {
    "LivenessFile": "",
    "LivenessSeconds": 15
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  }
}
