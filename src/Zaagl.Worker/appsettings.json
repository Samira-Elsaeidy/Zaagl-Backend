{
  // ARC-012 / BE-013 worker. Same sections as the API where shared (ConnectionStrings, Storage).
  "ConnectionStrings": {
    "Postgres": "Host=localhost;Port=5433;Database=zaagl;Username=zaagl;Password=zaagl_dev",
    // Optional: a separate login/pool for jobs; falls back to Postgres. Pool capped at Jobs:MaxPoolSize.
    "Jobs": ""
  },
  // Must be the same directory (same filesystem) the API uses (see the API's appsettings.json).
  "Storage": {
    "Root": "",
    "InternalPathPrefix": "/_protected/"
  },
  // The scan task (ARC-009 section 7, 10). Provider Fake is refused outside Development.
  "Scan": { "Provider": "Clamd", "Concurrency": 2, "RetryMinutes": [ 1, 5, 15, 60 ], "MaxAttempts": 6, "TimeoutSeconds": 300 },
  "ClamAv": { "Host": "localhost", "Port": 3310, "FailClosed": true, "ScanByPath": false },
  "Abuse": { "EvidenceRetentionDays": 30 },
  // Plan values (the quota ledger is built on them); keep identical to the API.
  "Plans": {
    "Guest": {
      "Content": { "MaxFileBytes": 26214400, "MaxSnippetBytes": 262144, "RetentionDays": 7, "QuarantineAfterExpiry": false, "StorageQuotaBytes": null },
      "Capabilities": { "IsPaid": false, "ApiKeys": false, "KeepStatsAfterPurge": false, "BurnAfterDownload": false, "PasswordOnContent": false, "ContentStatistics": false, "ManageContent": false }
    },
    "Free": {
      "Content": { "MaxFileBytes": 26214400, "MaxSnippetBytes": 524288, "RetentionDays": 7, "QuarantineAfterExpiry": true, "StorageQuotaBytes": 262144000 },
      "Capabilities": { "IsPaid": false, "ApiKeys": false, "KeepStatsAfterPurge": false, "BurnAfterDownload": false, "PasswordOnContent": false, "ContentStatistics": true, "ManageContent": true }
    },
    "Starter": {
      "Content": { "MaxFileBytes": 104857600, "MaxSnippetBytes": 2097152, "RetentionDays": 30, "QuarantineAfterExpiry": true, "StorageQuotaBytes": 5368709120 },
      "Capabilities": { "IsPaid": true, "ApiKeys": true, "KeepStatsAfterPurge": true, "BurnAfterDownload": true, "PasswordOnContent": true, "ContentStatistics": true, "ManageContent": true }
    }
  },
  "Jobs": {
    "MaxPoolSize": 10,
    // Runner for files.tasks: claim BatchSize per poll, MaxConcurrency at once, lease LeaseSeconds (extended every
    // lease/3), done rows kept DoneRetentionDays, ShutdownGraceSeconds for running tasks on SIGTERM.
    "Files": {
      "BatchSize": 10,
      "MaxConcurrency": 4,
      "PollIntervalMs": 2000,
      "LeaseSeconds": 300,
      "DoneRetentionDays": 7,
      "ShutdownGraceSeconds": 55
    }
  },
  "Worker": {
    "LivenessFile": "",
    "LivenessSeconds": 15
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  }
}
