<Project Sdk="Microsoft.NET.Sdk">

  <!--
    CLI-001 (DESKTOP_CLI_PLAN.md §4): the zaagl developer CLI, .NET 10 Native AOT.
    - No package references: hand-rolled argument parser, hand-written DTOs with one source-generated
      JsonSerializerContext (CliJsonContext), native credential stores through LibraryImport / function pointers.
    - IsAotCompatible turns on the trim, AOT and single-file analyzers at build time, and TreatWarningsAsErrors turns
      every IL2xxx / IL3xxx warning into a build error (RS0030 stays a warning, Directory.Build.props).
    - Publish: dotnet publish src/Zaagl.Cli -c Release -r <rid>   (PublishAot is on; needs the platform linker).
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>zaagl</AssemblyName>
    <RootNamespace>Zaagl.Cli</RootNamespace>
    <Version>0.1.0</Version>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <IsPackable>false</IsPackable>

    <PublishAot>true</PublishAot>
    <IsAotCompatible>true</IsAotCompatible>
    <InvariantGlobalization>true</InvariantGlobalization>
    <JsonSerializerIsReflectionEnabledByDefault>false</JsonSerializerIsReflectionEnabledByDefault>
    <UseSystemResourceKeys>true</UseSystemResourceKeys>
    <OptimizationPreference>Size</OptimizationPreference>
    <StackTraceSupport>false</StackTraceSupport>
    <EventSourceSupport>false</EventSourceSupport>
    <DebuggerSupport>false</DebuggerSupport>
    <HttpActivityPropagationSupport>false</HttpActivityPropagationSupport>
    <MetricsSupport>false</MetricsSupport>
    <TrimmerSingleWarn>false</TrimmerSingleWarn>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Zaagl.Cli.Tests" />
  </ItemGroup>

</Project>
