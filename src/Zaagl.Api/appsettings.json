{
  "ConnectionStrings": {
    "Postgres": "Host=localhost;Port=5433;Database=zaagl;Username=zaagl;Password=zaagl_dev",
    "Valkey": "localhost:6379,abortConnect=false"
  },
  "Database": {
    "MigrateOnStartup": false
  },
  // HybridCache's shared layer (L2 = Valkey). Valkey is optional at run time: when it is down or slow, each
  // L2 operation gives up after OperationTimeoutMs, and after FailuresBeforeBreak consecutive failures L2 is
  // skipped for BreakSeconds (then one probe). Reads then miss and fall back to the database (redirects use the
  // fast-timeout "redirects" pool, spec §7.0); link writes still succeed (the L1 copy is always removed).
  // MaxEntryLifetimeSeconds must be >= the longest HybridCache expiration (link snapshots: 300 s): a key whose
  // L2 delete was lost is not read from L2 for that long. MaxPendingRemovals bounds that per-key memory; past
  // it, every L2 read is skipped for MaxEntryLifetimeSeconds.
  "Cache": {
    "L2": {
      "OperationTimeoutMs": 250,
      "FailuresBeforeBreak": 1,
      "BreakSeconds": 30,
      "MaxEntryLifetimeSeconds": 300,
      "MaxPendingRemovals": 100000
    }
  },
  "Jwt": {
    "Issuer": "zaagl",
    "Audience": "zaagl",
    "ExpiryMinutes": 15
  },
  "AdminBootstrap": {
    "Email": "",
    "Password": ""
  },
  "Admin": {
    "AllowedNetworks": []
  },
  "Accounts": {
    "UnconfirmedTtlDays": 7
  },
  // BE-004 (C7, PD-15): uploaded bytes on local disk. Root: ONE absolute directory on ONE filesystem holding
  // temp/, objects/, quarantine/, previews/, thumbnails/ (promotes are atomic renames, so never split areas across
  // volumes). Empty = %LOCALAPPDATA%/zaagl/storage (development only). InternalPathPrefix: the Nginx internal
  // location that maps to Root for X-Accel-Redirect (ARC-008); only objects/previews/thumbnails are ever delivered.
  "Storage": {
    "Root": "",
    "InternalPathPrefix": "/_protected/",
    // ARC-009 section 13 / DEVOPS_PLAN 2.4 (env: Storage__Admission__*): when a new upload session is refused with 507.
    "Admission": { "MinFreeBytes": 0, "SafetyPercent": 5, "SoftClosePercent": 80, "RefuseNewPercent": 90, "RetryAfterSeconds": 300 },
    "TempMaxAgeHours": 24
  },
  // ARC-009 section 1 (BE-011/BE-012). Kinds: media in slice 1, media,file from slice 2. GuestsEnabled stays false until slice 2.
  "Uploads": {
    "MaxChunkBytes": 90000000,
    "SessionIdleHours": 24,
    "Kinds": "media,file",
    "GuestsEnabled": true
  },
  // The scan task runs in the worker (ARC-009 section 7, 10). Provider Fake is refused outside Development.
  "Scan": { "Provider": "Clamd", "Concurrency": 2, "RetryMinutes": [ 1, 5, 15, 60 ], "MaxAttempts": 6, "TimeoutSeconds": 300 },
  // clamd (env: ClamAv__Host, ClamAv__Port, ClamAv__FailClosed, ClamAv__ScanByPath). INSTREAM unless ScanByPath.
  "ClamAv": { "Host": "localhost", "Port": 3310, "FailClosed": true, "ScanByPath": false },
  // BE-005 hosts (spec §1.2, PD-03): Short and Api default to localhost in development. UserContent is the
  // user-content host (production: usercontent.zaa.gl); empty = not served by this process. It only ever reaches
  // /internal/delivery/* and its responses never carry Set-Cookie.
  "Hosts": {
    "UserContent": ""
  },
  // BE-005: Kestrel request-body limits. 2 MiB for every endpoint unless the endpoint raises its own limit.
  "Limits": {
    "MaxRequestBodyBytes": 2097152,
    "MinRequestBodyBytesPerSecond": 240,
    "MinRequestBodyGraceSeconds": 5
  },
  "ShortLinks": {
    "BaseUrl": "https://zaa.gl",
    "ScrambleKey": ""
  },
  "Coordinator": {
    "BaseUrl": "http://localhost:5085"
  },
  "Frontend": {
    "BaseUrl": ""
  },
  // Spec §7.3: the acceptable-use page (links disabled for abuse or safety) links here.
  "Links": {
    "ReportPageUrl": "https://app.zaa.gl/report"
  },
  "Cors": {
    "Origins": []
  },
  // Spec §7.13 (BE-030): only these hops may set the client IP through X-Forwarded-For/-Proto/-Host.
  // KnownProxies: EXACT addresses of the reverse proxy and the web/BFF container (never subnets).
  // KnownNetworks: CIDR ranges of the staging access gate only. ForwardLimit: 2 production, 3 staging.
  // Both lists empty = no forwarded header is trusted; every request is partitioned by its socket address.
  "Network": {
    "KnownProxies": [],
    "KnownNetworks": [],
    "ForwardLimit": 2
  },
  // Per-minute limits, in memory per instance, every IP limiter partitioned by IPv4 address / IPv6 /64.
  // Redirects (spec §7.3): 300 per partition; misses (404/410) 30 per /64 or IPv4 address, 120 per /56,
  // 300 per /48 or IPv4 /24 -> 429. HEAD counts like GET.
  "RateLimits": {
    "AuthPerMinute": 10,
    "LinkWritePerMinute": 60,
    "UnlockPerMinute": 10,
    "Redirects": {
      "Enabled": true,
      "PerMinute": 300,
      "MissesPerMinute": 30,
      "MissesPerMinutePer56": 120,
      "MissesPerMinutePer48": 300
    }
  },
  "Resolution": {
    "VisitorSalt": "change-me-in-production"
  },
  "GeoIp": {
    "DatabasePath": ""
  },
  "WebRisk": {
    "ApiKey": ""
  },
  "Guests": {
    "Enabled": true,
    "LinksPerDay": 20,
    "LinksPerDayPer56": 100,
    "LinksPerDayPer48": 300,
    "PerMinute": 5,
    "GlobalPerHour": 5000,
    "ExpiryDays": 7
  },
  "GUEST_KEY": "",
  "Safety": {
    "MonthlyLookupBudget": 100000,
    "TimeoutMs": 400,
    "DenyRedirectorHosts": []
  },
  "Abuse": {
    "EvidenceRetentionDays": 90
  },
  "Captcha": {
    "Enabled": true,
    "SiteKey": "",
    "Secret": ""
  },
  "Email": {
    "From": "no-reply@zaa.gl",
    "FromName": "Zaagl",
    "SmtpHost": "",
    "SmtpPort": 587,
    "SmtpUser": "",
    "SmtpPassword": "",
    "SmtpUseSsl": true,
    "DailyRunUtc": "06:00:00",
    "WebhookSecret": "",
    "ApiBaseUrl": "https://api.zaa.gl"
  },
  // PriceTiers: extra Stripe price id -> tier entries (ARC-005 §2). StarterPriceId is always Starter; no Pro (PD-04).
  "Stripe": {
    "SecretKey": "",
    "WebhookSecret": "",
    "StarterPriceId": "",
    "PriceTiers": {}
  },
  // BE-003 (ARC-005, C5): content limits and capability flags per plan, validated at startup. Sizes are bytes,
  // 1 MB = 1,048,576 bytes (PD-54). Approved values (PD-04, PD-06, PD-07, PD-54): file 25 MB guest/Free and
  // 100 MB Starter; retention 7/7/30 days; quarantine after expiry for accounts only; storage totals Free 250 MB,
  // Starter 5 GB; burn-after-download and password on content Starter only.
  // MaxSnippetBytes (PD-56): guest 256 KB, Free 512 KB, Starter 2 MB. 0 would refuse snippet creation (fail-closed).
  "Plans": {
    "Guest": {
      "Content": { "MaxFileBytes": 26214400, "MaxSnippetBytes": 262144, "RetentionDays": 7, "QuarantineAfterExpiry": false, "StorageQuotaBytes": null },
      "Capabilities": { "IsPaid": false, "ApiKeys": false, "KeepStatsAfterPurge": false, "BurnAfterDownload": false, "PasswordOnContent": false, "ContentStatistics": false, "ManageContent": false }
    },
    "Free": {
      "Content": { "MaxFileBytes": 26214400, "MaxSnippetBytes": 524288, "RetentionDays": 7, "QuarantineAfterExpiry": true, "StorageQuotaBytes": 262144000 },
      "Capabilities": { "IsPaid": false, "ApiKeys": false, "KeepStatsAfterPurge": false, "BurnAfterDownload": false, "PasswordOnContent": false, "ContentStatistics": true, "ManageContent": true }
    },
    "Starter": {
      "Content": { "MaxFileBytes": 104857600, "MaxSnippetBytes": 2097152, "RetentionDays": 30, "QuarantineAfterExpiry": true, "StorageQuotaBytes": 5368709120 },
      "Capabilities": { "IsPaid": true, "ApiKeys": true, "KeepStatsAfterPurge": true, "BurnAfterDownload": true, "PasswordOnContent": true, "ContentStatistics": true, "ManageContent": true }
    }
  },
  "Authentication": {
    "Google": { "ClientId": "", "ClientSecret": "" },
    "GitHub": { "ClientId": "", "ClientSecret": "" }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    }
  },
  "AllowedHosts": "*"
}
