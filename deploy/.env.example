# Copy to .env (next to docker-compose.yml) and adjust. Dev-only values are already inline in
# docker-compose.yml for a zero-config `docker compose up`; this file documents what production's
# equivalents are (spec §3) - production uses Docker secrets (files), never plain environment variables,
# and every value below gets its own real secret, never these dev placeholders.

PG_SUPERUSER_PASSWORD=change-me
APP_OWNER_PASSWORD=change-me
ALLOC_OWNER_PASSWORD=change-me
API_USER_PASSWORD=change-me
COORDINATOR_USER_PASSWORD=change-me

# 32 random bytes, base64. Generate: openssl rand -base64 32
SCRAMBLE_KEY_V1=

COORDINATOR_TOKEN=
COORDINATOR_ADMIN_TOKEN=

# JSON set of {kid, key} entries, >= 32 random bytes each; the newest signs, all validate (spec §7.4).
JWT_SIGNING_KEYS=

# 32 random bytes, for guest creator keys (spec §7.12) - not used yet, guest links are not built.
GUEST_KEY=

ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=

# Off by default in this build - Web Risk/Turnstile integration exists (WebRiskChecker) but Turnstile
# (CAPTCHA) is not wired up yet; see docs/TRACEABILITY.md.
WEB_RISK_API_KEY=
TURNSTILE_SECRET=

SMTP_PASSWORD=
EMAIL_WEBHOOK_SECRET=

# Off-host S3-compatible allocator sink credentials (spec §6.4) - not used in dev, which runs
# Allocator:Sink:Type=LocalFileSystem instead. Required before production ops init.
ALLOC_SINK_CREDENTIALS=
